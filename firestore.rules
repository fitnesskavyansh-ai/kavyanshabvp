rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Single Administrator Enforcement:
    // Only the authenticated user whose UID matches the configured admin UID is authorized.
    function isAdmin() {
      return request.auth != null 
        && request.auth.uid == 'i9mqewCLQ0fW7sXAKeoTX68CGF73';
    }

    // Activities Collection
    match /activities/{activityId} {
      // Public visitors can ONLY read published activities
      // Admin can read all activities (including drafts/unpublished)
      allow read: if (resource != null && resource.data.published == true) || isAdmin();

      // Only authenticated admin can create an activity
      // Validates required data types
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'description', 'date', 'category', 'published'])
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.published is bool;

      // Only authenticated admin can update an activity
      allow update: if isAdmin();

      // Only authenticated admin can delete an activity
      allow delete: if isAdmin();
    }

    // Default deny for any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
