# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin credentials for protected grievance/issue management dashboard
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="secure_password_here"
SESSION_SECRET="session_secret_change_in_production"

# Email Notification Service Settings
# Primary recipient for instant alerts whenever an issue is raised
NOTIFICATION_EMAIL="kavyanshkayasthabvp@gmail.com"
NOTIFICATION_CC_EMAIL=""

# Optional direct Gmail SMTP transport (for automated direct background sending)
# Generate via Google Account -> Security -> 2-Step Verification -> App Passwords
GMAIL_USER="kavyanshkayasthabvp@gmail.com"
GMAIL_APP_PASSWORD=""

# Web3Forms Access Key for Student Complaint Form (kavyanshkayasthabvp.in)
# Obtain your free access key from https://web3forms.com registered to kavyanshkayasthabvp@gmail.com
# For Vite + React static deployment (Firebase Hosting), set this environment variable
VITE_WEB3FORMS_ACCESS_KEY=

